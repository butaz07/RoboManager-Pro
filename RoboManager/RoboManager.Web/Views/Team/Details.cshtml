@model dynamic
@{
    ViewData["Title"] = "Detalles del Equipo";

    
    string ObtenerValorSeguro(dynamic item, string opcion1, string opcion2)
    {
        if (item is System.Text.Json.JsonElement json)
        {
            if (json.TryGetProperty(opcion1, out var val)) return val.ToString();
            if (json.TryGetProperty(char.ToUpper(opcion1[0]) + opcion1.Substring(1), out val)) return val.ToString();
            if (json.TryGetProperty(opcion2, out val)) return val.ToString();
        }
        return "N/A";
    }
}

<div class="container mt-5">
    <div class="card shadow-sm border-0 mb-4 border-start border-primary border-5">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="text-primary fw-bold mb-1"><i class="fas fa-users-cog me-2"></i> @ObtenerValorSeguro(Model, "nombre", "name")</h3>
                    <p class="text-muted mb-0 fs-5"><i class="fas fa-tag me-1"></i> Especialidad: <strong>@ObtenerValorSeguro(Model, "descripcion", "description")</strong></p>
                </div>
                <a href="/Team" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i> Volver</a>
            </div>
        </div>
    </div>

    <h4 class="mb-3 text-secondary"><i class="fas fa-id-badge me-2"></i>Integrantes Asignados</h4>

    <div class="row">
        @if (ViewBag.Miembros != null && ViewBag.Miembros.Count > 0)
        {
            foreach (var miembro in ViewBag.Miembros)
            {
                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body text-center">
                            <div class="mb-3">
                                <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                    <i class="fas fa-user text-primary fs-3"></i>
                                </div>
                            </div>
                            <h5 class="fw-bold mb-1">@ObtenerValorSeguro(miembro, "nombre", "name") @ObtenerValorSeguro(miembro, "apellido", "lastName")</h5>
                            <p class="text-muted small mb-2"><i class="fas fa-envelope me-1"></i> @ObtenerValorSeguro(miembro, "correo", "email")</p>

                            @{
                                int rol = 0;
                                if (miembro is System.Text.Json.JsonElement mJson && (mJson.TryGetProperty("rol", out var rProp) || mJson.TryGetProperty("Rol", out rProp)))
                                {
                                    rol = rProp.GetInt32();
                                }
                            }

                            @if (rol == 1)
                            {
                                <span class="badge bg-warning text-dark px-3 py-1"><i class="fas fa-star me-1"></i> Líder de Equipo</span>
                            }
                            else
                            {
                                <span class="badge bg-info text-dark px-3 py-1"><i class="fas fa-user-graduate me-1"></i> Estudiante</span>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-light text-center border p-5">
                    <i class="fas fa-user-slash fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">Este equipo aún no tiene integrantes asignados.</h5>
                    <a href="/Member/Create" class="btn btn-primary mt-2">Agregar un Miembro</a>
                </div>
            </div>
        }
    </div>
</div>