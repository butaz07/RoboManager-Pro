@model List<dynamic>

@{
    ViewData["Title"] = "Listado de Miembros";
}

<div class="container mt-5">
    <div class="text-center mb-4">
        <h2 class="fw-bold text-primary" style="color: #0d6efd !important;">Listado de Miembros</h2>
        <p class="text-muted">Gestiona y administra la información de los miembros del equipo registrados.</p>
    </div>

    <div class="d-flex justify-content-end mb-3 gap-2">
        <a href="/Member/Create" class="btn btn-primary">
            <i class="fas fa-plus-circle me-1"></i> Crear Nuevo Miembro
        </a>
        <a href="#" class="btn btn-secondary">
            <i class="fas fa-users-cog me-1"></i> Gestionar Equipos
        </a>
    </div>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover align-middle mb-0 bg-white">
            <thead class="bg-light" style="border-bottom: 3px solid #dee2e6;">
                <tr class="text-muted">
                    <th class="py-3">Nombre</th>
                    <th class="py-3">Apellido</th>
                    <th class="py-3">Correo</th>
                    <th class="py-3">Rol</th>
                    <th class="py-3">Estado</th>
                    <th class="py-3 text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    @foreach (var member in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@member.GetProperty("nombre").GetString()</td>
                            <td>@member.GetProperty("apellido").GetString()</td>
                            <td>@member.GetProperty("correo").GetString()</td>

                            <td>
                                @if (member.GetProperty("rol").GetInt32() == 0)
                                {
                                    <span>Estudiante</span>
                                }
                                else
                                {
                                    <span>Líder</span>
                                }
                            </td>

                            <td>
                                <span class="badge bg-success px-3 py-2 rounded-pill">Activo</span>
                            </td>

                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-2">
                                    <a href="/Member/Edit/@member.GetProperty("id").GetInt32()" class="btn btn-warning btn-sm text-white" title="Editar">
                                        <i class="fas fa-edit"></i> Editar
                                    </a>

                                    <form action="/Member/Delete" method="post" onsubmit="return confirm('¿Estás seguro de que deseas eliminar este miembro del equipo?');">
                                        <input type="hidden" name="id" value='@member.GetProperty("id").GetInt32()' />
                                        <button type="submit" class="btn btn-danger btn-sm" title="Eliminar">
                                            <i class="fas fa-trash-alt"></i> Eliminar
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            <i class="fas fa-folder-open fa-3x mb-3 text-light"></i>
                            <p>No hay miembros registrados todavía.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>