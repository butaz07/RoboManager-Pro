@model dynamic

@{
    ViewData["Title"] = "Editar Miembro";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0 mt-1"><i class="fas fa-user-edit me-2"></i>Editar Integrante</h5>
                </div>
                <div class="card-body bg-white">
                    <form action="/Member/Edit" method="post">
                        <input type="hidden" name="id" value='@Model.GetProperty("id").GetInt32()' />

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Nombre</label>
                            <input type="text" name="nombre" class="form-control" value='@Model.GetProperty("nombre").GetString()' required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Apellido</label>
                            <input type="text" name="apellido" class="form-control" value='@Model.GetProperty("apellido").GetString()' required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Correo Electrónico</label>
                            <input type="email" name="correo" class="form-control" value='@Model.GetProperty("correo").GetString()' required />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Rol en el equipo</label>
                            <select name="rol" class="form-select">
                                @if (Model.GetProperty("rol").GetInt32() == 0)
                                {
                                    <option value="0" selected>Estudiante</option>
                                    <option value="1">Líder</option>
                                }
                                else
                                {
                                    <option value="0">Estudiante</option>
                                    <option value="1" selected>Líder</option>
                                }
                            </select>
                        </div>
                        <div class="d-flex justify-content-between">
                            <a href="/Member" class="btn btn-light border">Cancelar</a>
                            <button type="submit" class="btn btn-warning px-4 fw-bold">Actualizar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>