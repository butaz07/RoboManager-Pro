@{
    ViewData["Title"] = "Crear Miembro";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-itla-blue text-white">
                    <h5 class="mb-0 mt-1"><i class="fas fa-user-plus me-2"></i>Nuevo Integrante</h5>
                </div>
                <div class="card-body bg-white">
                    <form action="/Member/Create" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Nombre</label>
                            <input type="text" name="nombre" class="form-control" placeholder="Ej. Carlos" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Apellido</label>
                            <input type="text" name="apellido" class="form-control" placeholder="Ej. Rodríguez" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Correo Electrónico</label>
                            <input type="email" name="correo" class="form-control" placeholder="usuario@itla.edu.do" required />
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Rol en el equipo</label>
                            <select name="rol" class="form-select">
                                <option value="0">Estudiante</option>
                                <option value="1">Líder</option>
                            </select>
                        </div>
                        <div class="d-flex justify-content-between">
                            <a href="/Member" class="btn btn-light border">Cancelar</a>
                            <button type="submit" class="btn btn-primary px-4">Guardar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>