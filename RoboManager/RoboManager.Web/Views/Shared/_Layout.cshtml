<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RoboManager</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* Color azul exacto al de tu imagen de referencia */
        .bg-itla-blue {
            background-color: #195cb0 !important;
        }

        .nav-link:hover {
            color: #f8f9fa !important;
            text-decoration: underline;
        }
    </style>
</head>
<body class="bg-light">

    <nav class="navbar navbar-expand-lg navbar-dark bg-itla-blue shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">
                <i class="fas fa-robot me-2"></i>RoboManager
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuNavegacion">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-end" id="menuNavegacion">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link text-white" href="/Member"><i class="fas fa-user-graduate me-1"></i> Miembros</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="/Team"><i class="fas fa-users me-1"></i> Equipos</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="/Project"><i class="fas fa-project-diagram me-1"></i> Proyectos</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="/Component"><i class="fas fa-microchip me-1"></i> Inventario</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-4 pb-5">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>