@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="p-5 text-white bg-dark rounded-3 shadow-sm" style="background: linear-gradient(135deg, #0d6efd 0%, #000000 100%);">
                <div class="container-fluid py-2">
                    <h1 class="display-5 fw-bold"><i class="fas fa-robot me-3"></i>Bienvenido a RoboManager</h1>
                    <p class="col-md-8 fs-5 mt-3">
                        Tu centro de comando para la gestión de proyectos de robótica. Monitorea el progreso del equipo, administra el inventario de hardware y coordina los próximos ensamblajes en un solo lugar.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 hover-shadow transition-all">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                        <i class="fas fa-project-diagram fa-2x text-primary"></i>
                    </div>
                    <div>
                        <h6 class="text-muted text-uppercase mb-1" style="font-size: 0.8rem; font-weight: 700;">Proyectos Activos</h6>
                        <h3 class="fw-bold mb-0 text-dark">@ViewBag.TotalProyectos</h3>
                    </div>
                </div>
                <div class="card-footer bg-white border-0 p-0 text-center pb-3">
                    <a href="/Project" class="text-decoration-none text-primary fw-semibold small">Ver todos <i class="fas fa-arrow-right ms-1"></i></a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 hover-shadow transition-all">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="bg-warning bg-opacity-10 p-3 rounded-circle me-3">
                        <i class="fas fa-tasks fa-2x text-warning"></i>
                    </div>
                    <div>
                        <h6 class="text-muted text-uppercase mb-1" style="font-size: 0.8rem; font-weight: 700;">Tareas Pendientes</h6>
                        <h3 class="fw-bold mb-0 text-dark">@ViewBag.TareasPendientes</h3>
                    </div>
                </div>
                <div class="card-footer bg-white border-0 p-0 text-center pb-3">
                    <a href="/ProjectTask" class="text-decoration-none text-warning fw-semibold small">Asignar tareas <i class="fas fa-arrow-right ms-1"></i></a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 hover-shadow transition-all">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="bg-success bg-opacity-10 p-3 rounded-circle me-3">
                        <i class="fas fa-microchip fa-2x text-success"></i>
                    </div>
                    <div>
                        <h6 class="text-muted text-uppercase mb-1" style="font-size: 0.8rem; font-weight: 700;">Piezas en Stock</h6>
                        <h3 class="fw-bold mb-0 text-dark">@ViewBag.TotalComponentes</h3>
                    </div>
                </div>
                <div class="card-footer bg-white border-0 p-0 text-center pb-3">
                    <a href="/Component" class="text-decoration-none text-success fw-semibold small">Ir al Almacén <i class="fas fa-arrow-right ms-1"></i></a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm rounded-4 hover-shadow transition-all">
                <div class="card-body p-4 d-flex align-items-center">
                    <div class="bg-danger bg-opacity-10 p-3 rounded-circle me-3">
                        <i class="far fa-calendar-alt fa-2x text-danger"></i>
                    </div>
                    <div>
                        <h6 class="text-muted text-uppercase mb-1" style="font-size: 0.8rem; font-weight: 700;">Próx. Reuniones</h6>
                        <h3 class="fw-bold mb-0 text-dark">@ViewBag.ProximasReuniones</h3>
                    </div>
                </div>
                <div class="card-footer bg-white border-0 p-0 text-center pb-3">
                    <a href="/Meeting" class="text-decoration-none text-danger fw-semibold small">Ver Cronograma <i class="fas fa-arrow-right ms-1"></i></a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
   
    .hover-shadow:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
    }

    .transition-all {
        transition: all 0.3s ease-in-out;
    }
</style>