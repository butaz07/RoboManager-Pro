@model dynamic

@{
    ViewData["Title"] = "Editar Proyecto";

    // Extrayendo y formateando fechas
    string fechaInicioStr = Convert.ToDateTime(Model.GetProperty("fechaInicio").GetString()).ToString("yyyy-MM-dd");
    string fechaFinStr = Convert.ToDateTime(Model.GetProperty("fechaFin").GetString()).ToString("yyyy-MM-dd");
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0 mt-1"><i class="fas fa-edit me-2"></i>Modificar Proyecto</h5>
                </div>
                <div class="card-body bg-white p-4">
                    <form action="/Project/Edit" method="post" novalidate>

                        <input type="hidden" name="id" value='@Model.GetProperty("id").GetInt32()' />

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Nombre del Proyecto</label>
                            <input type="text" name="nombre" class="form-control" value='@Model.GetProperty("nombre").GetString()' required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Descripción y Objetivos</label>
                            <textarea name="descripcion" class="form-control" rows="3" required>@Model.GetProperty("descripcion").GetString()</textarea>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-semibold">Fecha de Inicio</label>
                                <input type="date" name="fechaInicio" class="form-control" value="@fechaInicioStr" required />
                            </div>
                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-semibold">Fecha de Finalización (Límite)</label>
                                <input type="date" name="fechaFin" class="form-control" value="@fechaFinStr" required />
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="/Project" class="btn btn-light border">Cancelar</a>
                            <button type="submit" class="btn btn-warning fw-bold px-4"><i class="fas fa-sync-alt me-1"></i> Actualizar Proyecto</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>