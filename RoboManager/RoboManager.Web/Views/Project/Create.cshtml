@{
    ViewData["Title"] = "Crear Proyecto";
}

<div class="container mt-5">

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-itla-blue text-white">
                    <h5 class="mb-0 mt-1"><i class="fas fa-project-diagram me-2"></i>Nuevo Proyecto Robótico</h5>
                </div>
                <div class="card-body bg-white p-4">
                    <form action="/Project/Create" method="post">

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Nombre del Proyecto</label>
                            <input type="text" name="nombre" class="form-control" placeholder="Ej. Brazo Robótico Industrial" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Descripción y Objetivos</label>
                            <textarea name="descripcion" class="form-control" rows="3" placeholder="Detalla de qué trata este reto..." required></textarea>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-semibold">Fecha de Inicio</label>
                                <input type="date" name="fechaInicio" class="form-control" required />
                            </div>
                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-semibold">Fecha de Finalización (Límite)</label>
                                <input type="date" name="fechaFin" class="form-control" required />
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="/Project" class="btn btn-light border">Cancelar</a>
                            <button type="submit" class="btn btn-primary px-4"><i class="fas fa-save me-1"></i> Guardar Proyecto</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>