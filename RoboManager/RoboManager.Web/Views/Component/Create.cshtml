@{
    ViewData["Title"] = "Registrar Pieza";
}

<div class="container mt-5">
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-itla-blue text-white">
                    <h5 class="mb-0 mt-1"><i class="fas fa-plus-circle me-2"></i>Nueva Pieza de Inventario</h5>
                </div>
                <div class="card-body bg-white">
                    <form action="/Component/Create" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Nombre del Componente</label>
                            <input type="text" name="nombre" class="form-control" placeholder="Ej. Sensor Ultrasónico HC-SR04" required />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Tipo de Material</label>
                                <select name="tipo" class="form-select">
                                    <option value="0">Electrónico</option>
                                    <option value="1">Mecánico</option>
                                    <option value="2">Estructural</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Cantidad Inicial</label>
                                <input type="number" name="cantidad" class="form-control" value="1" min="1" required />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Estado Actual</label>
                            <select name="estado" class="form-select">
                                <option value="0">Disponible</option>
                                <option value="1">En Uso</option>
                                <option value="2">Dañado / Mantenimiento</option>
                            </select>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="/Component" class="btn btn-light border">Cancelar</a>
                            <button type="submit" class="btn btn-primary px-4">Guardar Pieza</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>